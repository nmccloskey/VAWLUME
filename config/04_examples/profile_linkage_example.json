{
  "project": {
    "source_mapping_profile": "example.project.mouse_courtship.folder_driven"
  },
  "recordings": {
    "default_recording_device_profile": "example.device.ultrasonic_usb_primary",
    "default_experimental_setup_profile": "example.setup.mouse_courtship_chamber"
  },
  "extractor_outputs": [
    {
      "extractor": "DeepSqueak",
      "output_mapping_profile": "vawlume.deepsqueak.output.v3_2"
    },
    {
      "extractor": "MUPET",
      "output_mapping_profile": "vawlume.mupet.output.v2_1"
    }
  ],
  "extraction_run_context": {
    "inherit": [
      "recording_device_profile",
      "experimental_setup_profile"
    ],
    "snapshot_linked_profiles": true,
    "permit_run_level_override": true
  },
  "provenance": {
    "record_profile_ids": true,
    "record_profile_versions": true,
    "record_profile_checksums": true
  }
}
